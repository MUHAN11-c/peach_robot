# =============================================================================
# ChangeTool.srv — 切换工具服务
# /change_tool 执行物理换工具流程；scene_attach/scene_detach 复用本类型更新附着碰撞体。
# /set_display_tool 只检查部署/附着工具一致性；这些入口均不重写 URDF/SRDF 运动学。
# 调用方：上位机任务调度节点、工具切换协调节点、工具管理节点
# 服务方：tool_changer 的 gripper_swap_worker 节点
# 说明：与 RunGripperSwap 不同，此服务直接指定目标工具 ID 进行切换
# =============================================================================
# ======================== 请求字段 ========================
string tool_id  # 工具 ID，如 gripper0/gripper2，见 ivg_description/config/tools.yaml
---
# ======================== 响应字段 ========================
bool success      # 当前服务处理器完成；不等于限位/实物安装确认
int32 error_code  # 错误代码：0=成功，非零=具体错误类型
string message    # 切换结果详细信息，包含执行过程和最终结果描述
