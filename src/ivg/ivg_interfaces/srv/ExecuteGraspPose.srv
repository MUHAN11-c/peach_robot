# =============================================================================
# ExecuteGraspPose.srv — 执行单次抓取放置任务服务
# 用途：对指定工件执行完整的抓取-放置动作序列
#       （视觉估计 → 接近 → 抓取 → 抬升 → 移动 → 放置）
# 调用方：上位机任务调度节点 / Web 视觉抓取面板
# 服务方：ivg_demo_services/grasp_trigger_node 的 /execute_single_grasp
# 说明：这是视觉引导抓取的核心服务接口，内部包含接近、抓取闭合、抬升、
#       移动至放置偏移、开爪；当前周期末尾没有额外退回 home
#       use_visual_estimation=true 时从缓存 PoseArray 选双向最竖直姿态，不检查 stamp；
#       false 时使用参数中预设的常量位姿
# =============================================================================
# ======================== 请求字段 ========================
string object_id               # 调用者标识；当前处理器不按此字段筛选对象/参数
bool use_visual_estimation     # true=使用缓存 GraspNet PoseArray 确定抓取位姿，
                               # false=使用服务端预先配置的参数常量位姿
---
# ======================== 响应字段 ========================
bool success                    # true=完整抓取-放置序列执行成功
string message                  # 状态消息或错误信息，失败时包含具体阶段和原因
geometry_msgs/Point final_position       # 最终使用的抓取位置（米）
geometry_msgs/Quaternion final_orientation  # 最终使用的抓取姿态（四元数），用于记录和日志
